false, "c": null}]}, {"t": "li", "mark": "1.", "runs": [{"x": " Para hacer un ofrecimiento, invitación o sugerencia. Para este caso se hace sólo con los pronombres ", "b": false, "i": false, "c": null}, {"x": "“I” ", "b": false, "i": false, "c": "aux"}, {"x": "y", "b": false, "i": false, "c": null}, {"x": " “We”", "b": false, "i": false, "c": "aux"}, {"x": " y se asemeja a nuestra expresión “Quieres que...”", "b": false, "i": false, "c": null}]}, {"t": "grid", "rows": [[[{"x": "Shall", "b": false, "i": true, "c": null}, {"x": " we dance?", "b": false, "i": false, "c": null}], [{"x": "Quieres que", "b": false, "i": true, "c": null}, {"x": " bailemos?", "b": false, "i": false, "c": null}]]]}, {"t": "p", "runs": [{"x": "Shall ", "b": false, "i": true, "c": null}, {"x": "I call the doctor? ", "b": false, "i": false, "c": null}, {"x": "Quieres que", "b": false, "i": true, "c": null}, {"x": " llame al doctor?", "b": false, "i": false, "c": null}]}, {"t": "grid", "rows": [[[{"x": "Shall", "b": false, "i": true, "c": null}, {"x": " I take you to the hotel?", "b": false, "i": false, "c": null}], [{"x": "Quieres que", "b": false, "i": true, "c": null}, {"x": " te lleve al hotel?", "b": false, "i": false, "c": null}]]]}, {"t": "li", "mark": "2.", "runs": [{"x": " Para expresar una promesa hecha.", "b": false, "i": false, "c": null}]}, {"t": "p", "runs": [{"x": "I ", "b": false, "i": false, "c": null}, {"x": "shall", "b": false, "i": true, "c": null}, {"x": " be there tomorrow.", "b": false, "i": false, "c": null}]}, {"t": "li", "mark": "3.", "runs": [{"x": " Para denotar un futuro muy cierto y evidente.", "b": false, "i": false, "c": null}]}, {"t": "grid", "rows": [[[{"x": "You ", "b": false, "i": false, "c": null}, {"x": "shall", "b": false, "i": true, "c": null}, {"x": " die if you don’t eat.", "b": false, "i": false, "c": null}], [{"x": "Morirás si no comes.", "b": false, "i": false, "c": null}]]]}, {"t": "li", "mark": "4.", "runs": [{"x": " Para pedir un consejo. Se puede 