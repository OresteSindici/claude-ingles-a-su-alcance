{
  "hosting": {
    "public": "app/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/@(pages|audio|homenaje|icons)/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/@(sw.js|index.html|data/**)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
